<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔥 Trending Skills 2026"
            android:textColor="#00FFB3"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🤖 Artificial Intelligence"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:padding="16dp"
            android:background="#1A1A1A"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="☁ Cloud Computing"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:padding="16dp"
            android:background="#1A1A1A"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📱 Kotlin Development"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:padding="16dp"
            android:background="#1A1A1A"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔐 Cyber Security"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:padding="16dp"
            android:background="#1A1A1A"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 Data Analytics"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:padding="16dp"
            android:background="#1A1A1A"
            android:layout_marginBottom="12dp"/>

    </LinearLayout>

</ScrollView>